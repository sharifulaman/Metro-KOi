# Copy to .env.local.

# Google Maps JavaScript API key (Google Cloud console -> APIs & Services -> Credentials). Put the real one in .env.local.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase (Project Settings -> API). The anon key is safe in the app because RLS is on.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

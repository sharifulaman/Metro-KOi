# Copy to .env.local and set your PC's Wi-Fi IP (run `ipconfig`, IPv4 Address).
# Without it the app uses http://localhost:8080, which only works on web/emulators.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080

# Google Maps JavaScript API key (Google Cloud console -> APIs & Services -> Credentials). Put the real one in .env.local.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

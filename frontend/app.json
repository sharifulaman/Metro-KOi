{
  "expo": {
    "name": "Metro Koi",
    "slug": "metro-koi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.metrokoi.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Metro Koi uses your location only while you share a metro ride, to show the train live for other riders.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "While you share a ride, Metro Koi keeps reading your position when the screen is locked. Sharing stops when the ride ends.",
        "UIBackgroundModes": [
          "location",
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E9F6E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.metrokoi.app",
      "permissions": [
        "android.permission.NFC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-notifications",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Metro Koi reads your MRT Pass or Rapid Pass by NFC to show its balance and recent trips. Nothing is written to the card.",
          "systemCodes": [
            "90E3"
          ],
          "includeNdefEntitlement": false
        }
      ]
    ],
    "scheme": "metrokoi",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "473f5563-5b6a-492d-a85d-b7e9babe657b"
      }
    }
  }
}